ENVIRONMENT=development
DEBUG=false

# One of: fake, openai
LLM_PROVIDER=fake

# Required only when LLM_PROVIDER=openai or EMBEDDING_PROVIDER=openai.
# Never commit a real key.
OPENAI_API_KEY=sk-your-api-key-here
OPENAI_MODEL=gpt-4o-mini

# One of: fake, openai. Independent of LLM_PROVIDER.
EMBEDDING_PROVIDER=fake
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# One of: memory, pgvector
VECTOR_STORE_PROVIDER=memory

# Required only when VECTOR_STORE_PROVIDER=pgvector. Matches
# docker-compose.yml's default credentials for local development.
DATABASE_URL=postgresql+asyncpg://agentive:agentive@localhost:5432/agentive

# Default VectorRetriever.retrieve() top_k, overridable per call.
RETRIEVAL_TOP_K=5

# No default on purpose - leave unset (uncomment only once a real
# threshold is justified by evaluation data; an empty value is invalid).
# See README's Retrieval section for why.
# RETRIEVAL_MIN_SCORE=0.75

# Only "memory" is implemented today (see README's Conversation context section).
CONVERSATION_STORE_PROVIDER=memory

# Last N messages (~half that many turns) sent to the LLM as conversation
# context alongside the current question.
CONVERSATION_HISTORY_WINDOW=6

# Only "fake" is implemented today (see README's Tools section).
BUSINESS_SERVICE_PROVIDER=fake
