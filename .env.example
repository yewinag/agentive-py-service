ENVIRONMENT=development
DEBUG=false

# One of: fake, openai
LLM_PROVIDER=fake

# Required only when LLM_PROVIDER=openai or EMBEDDING_PROVIDER=openai.
# Never commit a real key.
OPENAI_API_KEY=sk-your-api-key-here
OPENAI_MODEL=gpt-4o-mini

# One of: fake, openai. Independent of LLM_PROVIDER. For real, persistent
# Qdrant knowledge ingestion (python -m app.knowledge.ingest), set this to
# "openai" (and set OPENAI_API_KEY above) - fake embeddings are for tests
# and offline development only. Switching between "fake" and "openai"
# changes the vector dimension (8 vs. this model's dimension below), so
# re-run the ingestion command with --reset afterward - see README's
# "Handling stale documents" / embedding-dimension notes.
EMBEDDING_PROVIDER=fake
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# One of: memory, pgvector, qdrant
VECTOR_STORE_PROVIDER=memory

# Required only when VECTOR_STORE_PROVIDER=pgvector. Matches
# docker-compose.yml's default credentials for local development.
DATABASE_URL=postgresql+asyncpg://agentive:agentive@localhost:5432/agentive

# Used only when VECTOR_STORE_PROVIDER=qdrant. Matches docker-compose.yml's
# local qdrant service; no credentials involved, so this default is safe.
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=knowledge_chunk_embeddings

# Default VectorRetriever.retrieve() top_k, overridable per call.
RETRIEVAL_TOP_K=5

# No default on purpose - leave unset (uncomment only once a real
# threshold is justified by evaluation data; an empty value is invalid).
# See README's Retrieval section for why.
# RETRIEVAL_MIN_SCORE=0.75

# Only "memory" is implemented today (see README's Conversation context section).
CONVERSATION_STORE_PROVIDER=memory

# Last N messages (~half that many turns) sent to the LLM as conversation
# context alongside the current question.
CONVERSATION_HISTORY_WINDOW=6

# Only "fake" is implemented today (see README's Tools section).
BUSINESS_SERVICE_PROVIDER=fake

# One of: existing, langchain. Selects which RagAnswerer backs
# POST /api/v1/chat (app/chats/service.py:get_rag_answerer). "existing"
# (default) is AgentService - retrieval + bounded tool-calling +
# LLMProvider, unchanged since Step 15. "langchain" is Phase 2.8's
# KnowledgeBaseRetriever + LangChainRagGenerationService - no tool
# calling or conversation history yet; needs EMBEDDING_PROVIDER=openai,
# VECTOR_STORE_PROVIDER=qdrant, and OPENAI_API_KEY set to actually work.
RAG_PROVIDER=existing
